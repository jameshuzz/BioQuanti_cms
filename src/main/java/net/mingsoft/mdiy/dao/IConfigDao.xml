<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="net.mingsoft.mdiy.dao.IConfigDao">
	<cache />
	<resultMap id="resultMap" type="net.mingsoft.mdiy.entity.ConfigEntity">
			<id column="id" property="id" /><!--编号 -->
				<result column="config_name" property="configName" /><!--模型名称 -->
				<result column="config_data" property="configData" /><!--模型数据 -->
				<result column="config_type" property="configType" /><!--模型类型 -->
				<result column="create_by" property="createBy" /><!--创建人 -->
				<result column="create_date" property="createDate" /><!--创建时间 -->
				<result column="update_by" property="updateBy" /><!--修改人 -->
				<result column="update_date" property="updateDate" /><!--修改时间 -->
				<result column="del" property="del" /><!--删除标记 -->
	</resultMap>

	<!-- 根据查询实体开始 -->
	<select id="getByConfigName" resultMap="resultMap">
		select * from MDIY_CONFIG where config_name = #{configName}
	</select>

	<select id="getByEntity" resultType="net.mingsoft.mdiy.entity.ConfigEntity" resultMap="resultMap" useCache="true">
		select * from MDIY_CONFIG
		<where>
			<if test="configName != null and configName != ''"> and config_name = #{configName} </if>
			<if test="configType != null and configType != ''"> and config_type = #{configType} </if>
			<if test="appId != null and appId != ''"> and app_id = #{appId} </if>
			<if test="appId == null or appId == ''"> and app_id = 'global' </if>
		</where>
	</select>

	<update id="updateCache"  flushCache="true">
		UPDATE MDIY_CONFIG set del=del where del &lt; 0
	</update>

</mapper>
